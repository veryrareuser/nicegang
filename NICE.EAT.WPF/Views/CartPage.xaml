<Page x:Class="NICE.EAT.WPF.Views.CartPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{StaticResource BgDeepBrush}"
      Title="Cart">

    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="🛒 Your Cart" Style="{StaticResource HeadingText}" />
            <TextBlock x:Name="HeaderSub"
                       Style="{StaticResource SubText}" Margin="0,5,0,0" />
        </StackPanel>

        <!-- Main content: 2 columns -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="320" />
            </Grid.ColumnDefinitions>

            <!-- LEFT: Cart items -->
            <ScrollViewer Grid.Column="0" Margin="0,0,16,0"
                          VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock x:Name="EmptyMsg"
                               Text="Your cart is empty. Browse Recommendations to add items!"
                               Style="{StaticResource SubText}"
                               HorizontalAlignment="Center"
                               Margin="0,60,0,0"
                               Visibility="Collapsed" />

                    <ItemsControl x:Name="CartList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Item info -->
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{Binding MenuItemName}"
                                                       FontWeight="SemiBold" FontSize="15" />
                                            <TextBlock Text="{Binding FromDisplay}"
                                                       Foreground="{StaticResource AccentLightBrush}"
                                                       FontSize="12"
                                                       Margin="0,2,0,0" />
                                            <TextBlock Style="{StaticResource SubText}"
                                                       Margin="0,4,0,0"
                                                       Text="{Binding UnitPriceDisplay}" />
                                        </StackPanel>

                                        <!-- Qty controls -->
                                        <StackPanel Grid.Column="1" Orientation="Horizontal"
                                                    VerticalAlignment="Center" Margin="12,0">
                                            <Button Content="−" Tag="{Binding}"
                                                    Click="BtnDecrement_Click"
                                                    Width="28" Height="28" FontSize="16"
                                                    FontWeight="Bold" Padding="0"
                                                    Style="{StaticResource GhostButton}"
                                                    HorizontalContentAlignment="Center" />
                                            <TextBlock Text="{Binding Quantity}"
                                                       FontWeight="Bold" FontSize="16"
                                                       VerticalAlignment="Center"
                                                       Margin="8,0" MinWidth="20"
                                                       TextAlignment="Center" />
                                            <Button Content="＋" Tag="{Binding}"
                                                    Click="BtnIncrement_Click"
                                                    Width="28" Height="28" FontSize="14"
                                                    FontWeight="Bold" Padding="0"
                                                    Style="{StaticResource GhostButton}"
                                                    HorizontalContentAlignment="Center" />
                                        </StackPanel>

                                        <!-- Subtotal + remove -->
                                        <StackPanel Grid.Column="2" VerticalAlignment="Center"
                                                    HorizontalAlignment="Right">
                                            <TextBlock Text="{Binding SubtotalDisplay}"
                                                       FontWeight="SemiBold" FontSize="14"
                                                       Foreground="{StaticResource AccentBrush}"
                                                       HorizontalAlignment="Right" />
                                            <Button Content="✕ Remove" Tag="{Binding}"
                                                    Click="BtnRemove_Click"
                                                    FontSize="11" Padding="4,2"
                                                    Foreground="{StaticResource TextSecondaryBrush}"
                                                    Style="{StaticResource GhostButton}"
                                                    HorizontalAlignment="Right"
                                                    HorizontalContentAlignment="Right"
                                                    Margin="0,4,0,0" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Quick-add section -->
                    <Border Style="{StaticResource Card}" Margin="0,8,0,0">
                        <StackPanel>
                            <TextBlock Text="➕ QUICK ADD"
                                       FontWeight="SemiBold" FontSize="12"
                                       Foreground="{StaticResource AccentBrush}"
                                       Margin="0,0,0,12" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ComboBox x:Name="QARestaurantBox" Grid.Column="0"
                                          Height="44"
                                          SelectionChanged="QARestaurantBox_SelectionChanged" />
                                <ComboBox x:Name="QAMenuBox" Grid.Column="2"
                                          Height="44" />
                                <Button Grid.Column="4" Content="  Add  "
                                        Style="{StaticResource PrimaryButton}"
                                        Height="44"
                                        Click="BtnQuickAdd_Click" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- RIGHT: Summary panel -->
            <Border Grid.Column="1" Style="{StaticResource Card}"
                    VerticalAlignment="Top">
                <StackPanel>
                    <TextBlock Text="ORDER SUMMARY"
                               FontWeight="SemiBold" FontSize="12"
                               Foreground="{StaticResource AccentBrush}"
                               Margin="0,0,0,16" />

                    <Grid Margin="0,0,0,8">
                        <TextBlock Text="Subtotal" Style="{StaticResource SubText}" />
                        <TextBlock x:Name="SubtotalText"
                                   HorizontalAlignment="Right"
                                   FontWeight="SemiBold" />
                    </Grid>

                    <Grid x:Name="DiscountRow" Margin="0,0,0,8" Visibility="Collapsed">
                        <TextBlock x:Name="DiscountLabel"
                                   Style="{StaticResource SubText}" />
                        <TextBlock x:Name="DiscountText"
                                   HorizontalAlignment="Right"
                                   Foreground="{StaticResource GreenBrush}"
                                   FontWeight="SemiBold" />
                    </Grid>

                    <!-- Delivery toggle -->
                    <CheckBox x:Name="DeliveryCheck"
                              Content="🚚  Delivery (+Rp 5,000)"
                              Margin="0,8,0,0"
                              Checked="DeliveryCheck_Changed"
                              Unchecked="DeliveryCheck_Changed" />
                    <StackPanel x:Name="DeliveryPanel" Visibility="Collapsed"
                                Margin="0,8,0,0">
                        <TextBlock Text="DELIVERY ADDRESS" Style="{StaticResource FieldLabel}" />
                        <TextBox x:Name="DeliveryAddr" Height="44" />
                    </StackPanel>

                    <Grid x:Name="DeliveryRow" Margin="0,8,0,8" Visibility="Collapsed">
                        <TextBlock Text="Delivery Fee" Style="{StaticResource SubText}" />
                        <TextBlock Text="Rp 5,000"
                                   HorizontalAlignment="Right"
                                   FontWeight="SemiBold" />
                    </Grid>

                    <Border Background="{StaticResource BorderBrush}"
                            Height="1" Margin="0,8,0,12" />

                    <Grid Margin="0,0,0,20">
                        <TextBlock Text="TOTAL" FontWeight="Bold" FontSize="14" />
                        <TextBlock x:Name="TotalText"
                                   HorizontalAlignment="Right"
                                   FontSize="20" FontWeight="Bold"
                                   Foreground="{StaticResource AccentBrush}" />
                    </Grid>

                    <Button x:Name="BtnCheckout"
                            Content="✅  Place Order"
                            Style="{StaticResource PrimaryButton}"
                            HorizontalAlignment="Stretch"
                            Height="48"
                            Click="BtnCheckout_Click" />

                    <TextBlock x:Name="StatusMsg"
                               Margin="0,10,0,0"
                               TextWrapping="Wrap"
                               FontSize="13"
                               Visibility="Collapsed" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Page>
