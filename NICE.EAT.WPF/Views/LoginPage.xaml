<Page x:Class="NICE.EAT.WPF.Views.LoginPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{StaticResource BgDeepBrush}"
      Title="Login">

    <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Width="420">
        <StackPanel>

            <!-- Logo / Header -->
            <TextBlock Text="🍽️" FontSize="48" HorizontalAlignment="Center" Margin="0,0,0,6" />
            <TextBlock Text="NICE.EAT"
                       FontSize="30" FontWeight="Bold"
                       Foreground="{StaticResource AccentBrush}"
                       HorizontalAlignment="Center" />
            <TextBlock Text="Smart Restaurant Recommender"
                       Style="{StaticResource SubText}"
                       HorizontalAlignment="Center" Margin="0,4,0,28" />

            <!-- Card -->
            <Border Style="{StaticResource Card}">
                <StackPanel>

                    <!-- Tab row — equal halves, both centered -->
                    <Grid Margin="0,0,0,22">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button x:Name="TabLoginBtn"
                                Grid.Column="0"
                                Content="Login"
                                Style="{StaticResource PrimaryButton}"
                                HorizontalAlignment="Stretch"
                                Click="TabLoginBtn_Click" />
                        <Button x:Name="TabRegisterBtn"
                                Grid.Column="2"
                                Content="Register"
                                Style="{StaticResource TabInactiveButton}"
                                HorizontalAlignment="Stretch"
                                Click="TabRegisterBtn_Click" />
                    </Grid>

                    <!-- Login Panel -->
                    <StackPanel x:Name="LoginPanel">
                        <TextBlock Text="USERNAME" Style="{StaticResource FieldLabel}" />
                        <TextBox x:Name="LoginUsername" Height="44" Margin="0,0,0,16" />
                        <Button Content="🔑  Sign In"
                                Style="{StaticResource PrimaryButton}"
                                HorizontalAlignment="Stretch"
                                Click="BtnSignIn_Click" />
                    </StackPanel>

                    <!-- Register Panel (hidden by default) -->
                    <StackPanel x:Name="RegisterPanel" Visibility="Collapsed">
                        <TextBlock Text="USERNAME" Style="{StaticResource FieldLabel}" />
                        <TextBox x:Name="RegUsername" Height="44" Margin="0,0,0,14" />
                        <TextBlock Text="EMAIL" Style="{StaticResource FieldLabel}" />
                        <TextBox x:Name="RegEmail" Height="44" Margin="0,0,0,14" />
                        <CheckBox x:Name="RegPremium"
                                  Content="Register as Premium member (10% discount)"
                                  Margin="0,0,0,16" />
                        <Button Content="📝  Create Account"
                                Style="{StaticResource PrimaryButton}"
                                HorizontalAlignment="Stretch"
                                Click="BtnRegister_Click" />
                    </StackPanel>

                    <!-- Status message -->
                    <TextBlock x:Name="StatusMsg"
                               Foreground="{StaticResource AccentBrush}"
                               Margin="0,14,0,0"
                               TextWrapping="Wrap"
                               FontSize="13"
                               Visibility="Collapsed" />
                </StackPanel>
            </Border>

            <!-- Hint -->
            <TextBlock Text="Demo accounts: demo_user · vip_member"
                       Style="{StaticResource SubText}"
                       HorizontalAlignment="Center" Margin="0,16,0,0" />
        </StackPanel>
    </Grid>
</Page>
