<Page x:Class="NICE.EAT.WPF.Views.RecommendPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{StaticResource BgDeepBrush}"
      Title="Recommendations">

    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Page header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="🔍 Find Restaurants" Style="{StaticResource HeadingText}" />
            <TextBlock Text="Set your preferences, search, and add items to your cart"
                       Style="{StaticResource SubText}" Margin="0,5,0,0" />
        </StackPanel>

        <!-- Filter card -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Budget -->
                <StackPanel Grid.Column="0" Margin="0,0,14,0">
                    <TextBlock Text="MAX BUDGET (IDR)" Style="{StaticResource FieldLabel}" />
                    <TextBox x:Name="BudgetBox" Height="44" Text="30000" />
                </StackPanel>

                <!-- Max Spicy -->
                <StackPanel Grid.Column="1" Margin="0,0,14,0">
                    <TextBlock x:Name="SpicyLabel" Style="{StaticResource FieldLabel}"
                               Text="MAX SPICY: 2" />
                    <Slider x:Name="SpicySlider"
                            Minimum="0" Maximum="5" Value="2"
                            TickFrequency="1" IsSnapToTickEnabled="True"
                            VerticalAlignment="Center" Height="44"
                            ValueChanged="SpicySlider_ValueChanged" />
                </StackPanel>

                <!-- Mood -->
                <StackPanel Grid.Column="2" Margin="0,0,14,0">
                    <TextBlock Text="MOOD" Style="{StaticResource FieldLabel}" />
                    <ComboBox x:Name="MoodBox" Height="44">
                        <ComboBoxItem Content="happy"       IsSelected="True" />
                        <ComboBoxItem Content="bored" />
                        <ComboBoxItem Content="angry" />
                        <ComboBoxItem Content="sad" />
                        <ComboBoxItem Content="stressed" />
                        <ComboBoxItem Content="calm" />
                        <ComboBoxItem Content="adventurous" />
                    </ComboBox>
                </StackPanel>

                <!-- Vegan -->
                <StackPanel Grid.Column="3" VerticalAlignment="Bottom"
                            Margin="0,0,14,0" Height="44"
                            Orientation="Horizontal">
                    <CheckBox x:Name="VeganCheck"
                              Content="🌿 Vegan only"
                              VerticalAlignment="Center" />
                </StackPanel>

                <!-- Search button -->
                <Button Grid.Column="4" Content="  Search →  "
                        Style="{StaticResource PrimaryButton}"
                        VerticalAlignment="Bottom" Height="44"
                        Click="BtnSearch_Click" />
            </Grid>
        </Border>

        <!-- Results -->
        <Grid Grid.Row="2">
            <TextBlock x:Name="EmptyMsg"
                       Text="No results yet — fill in the filters and press Search."
                       Style="{StaticResource SubText}"
                       HorizontalAlignment="Center" VerticalAlignment="Center" />

            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="ResultsList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{Binding Name}"
                                                   FontSize="16" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Address}"
                                                   Style="{StaticResource SubText}"
                                                   Margin="0,3,0,10" />
                                        <!-- Tags -->
                                        <WrapPanel Margin="0,0,0,10">
                                            <Border Background="{StaticResource BgPanelBrush}"
                                                    CornerRadius="4" Padding="8,3" Margin="0,0,6,4">
                                                <TextBlock Text="{Binding SpicyDisplay}"
                                                           FontSize="12"
                                                           Foreground="{StaticResource AccentBrush}" />
                                            </Border>
                                            <Border Background="{StaticResource BgPanelBrush}"
                                                    CornerRadius="4" Padding="8,3" Margin="0,0,6,4">
                                                <TextBlock Text="{Binding VeganDisplay}" FontSize="12" />
                                            </Border>
                                            <Border Background="{StaticResource BgPanelBrush}"
                                                    CornerRadius="4" Padding="8,3" Margin="0,0,0,4">
                                                <TextBlock Text="{Binding WaitDisplay}" FontSize="12" />
                                            </Border>
                                        </WrapPanel>

                                        <!-- Menu items with add-to-cart buttons -->
                                        <ItemsControl ItemsSource="{Binding MenuItems}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,2">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0"
                                                                   Text="{Binding DisplayText}"
                                                                   FontSize="12"
                                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                                   VerticalAlignment="Center" />
                                                        <Button Grid.Column="1"
                                                                Content="＋ Cart"
                                                                Tag="{Binding}"
                                                                FontSize="11"
                                                                Padding="8,3"
                                                                Cursor="Hand"
                                                                Click="BtnAddToCart_Click">
                                                            <Button.Template>
                                                                <ControlTemplate TargetType="Button">
                                                                    <Border x:Name="ab"
                                                                            Background="{StaticResource BgInputBrush}"
                                                                            CornerRadius="4"
                                                                            Padding="{TemplateBinding Padding}">
                                                                        <ContentPresenter
                                                                            HorizontalAlignment="Center"
                                                                            VerticalAlignment="Center" />
                                                                    </Border>
                                                                    <ControlTemplate.Triggers>
                                                                        <Trigger Property="IsMouseOver" Value="True">
                                                                            <Setter TargetName="ab"
                                                                                    Property="Background"
                                                                                    Value="{StaticResource AccentBrush}" />
                                                                        </Trigger>
                                                                    </ControlTemplate.Triggers>
                                                                </ControlTemplate>
                                                            </Button.Template>
                                                        </Button>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>

                                    <!-- Right: rating + price -->
                                    <StackPanel Grid.Column="1"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Top"
                                                Margin="16,0,0,0">
                                        <TextBlock Text="{Binding RatingDisplay}"
                                                   FontSize="20" FontWeight="Bold"
                                                   Foreground="{StaticResource AccentBrush}"
                                                   HorizontalAlignment="Right" />
                                        <TextBlock Text="{Binding PriceDisplay}"
                                                   Style="{StaticResource SubText}"
                                                   HorizontalAlignment="Right"
                                                   Margin="0,3,0,0" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- Toast notification (rendered AFTER ScrollViewer = on top) -->
            <Border x:Name="Toast"
                    Background="{StaticResource GreenBrush}"
                    CornerRadius="8" Padding="14,8"
                    HorizontalAlignment="Right" VerticalAlignment="Top"
                    Margin="0,0,10,0"
                    Panel.ZIndex="100"
                    Visibility="Collapsed">
                <TextBlock x:Name="ToastText" Foreground="White"
                           FontWeight="SemiBold" FontSize="13" />
            </Border>
        </Grid>
    </Grid>
</Page>
