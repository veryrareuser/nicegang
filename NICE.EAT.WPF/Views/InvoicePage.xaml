<Page x:Class="NICE.EAT.WPF.Views.InvoicePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{StaticResource BgDeepBrush}"
      Title="Invoice">

    <ScrollViewer Margin="28" VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="600" HorizontalAlignment="Center">

            <!-- Header -->
            <TextBlock Text="🧾" FontSize="40" HorizontalAlignment="Center" Margin="0,10,0,6" />
            <TextBlock Text="Order Confirmed!"
                       FontSize="24" FontWeight="Bold"
                       Foreground="{StaticResource GreenBrush}"
                       HorizontalAlignment="Center" />
            <TextBlock x:Name="InvoiceIdText"
                       Style="{StaticResource SubText}"
                       HorizontalAlignment="Center" Margin="0,4,0,24" />

            <!-- Invoice card -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <!-- Customer + date -->
                    <Grid Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="CUSTOMER" Style="{StaticResource FieldLabel}" />
                            <TextBlock x:Name="CustomerText" FontWeight="SemiBold" />
                        </StackPanel>
                        <StackPanel HorizontalAlignment="Right">
                            <TextBlock Text="DATE" Style="{StaticResource FieldLabel}"
                                       HorizontalAlignment="Right" />
                            <TextBlock x:Name="DateText"
                                       HorizontalAlignment="Right" />
                        </StackPanel>
                    </Grid>

                    <!-- Delivery info -->
                    <StackPanel x:Name="DeliveryInfo" Visibility="Collapsed"
                                Margin="0,0,0,16">
                        <TextBlock Text="DELIVERY TO" Style="{StaticResource FieldLabel}" />
                        <TextBlock x:Name="DeliveryText" />
                    </StackPanel>

                    <Border Background="{StaticResource BorderBrush}"
                            Height="1" Margin="0,0,0,14" />

                    <!-- Column headers -->
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="60" />
                            <ColumnDefinition Width="100" />
                            <ColumnDefinition Width="100" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="ITEM" Style="{StaticResource FieldLabel}" />
                        <TextBlock Grid.Column="1" Text="QTY" Style="{StaticResource FieldLabel}"
                                   TextAlignment="Center" />
                        <TextBlock Grid.Column="2" Text="PRICE" Style="{StaticResource FieldLabel}"
                                   TextAlignment="Right" />
                        <TextBlock Grid.Column="3" Text="TOTAL" Style="{StaticResource FieldLabel}"
                                   TextAlignment="Right" />
                    </Grid>

                    <!-- Line items -->
                    <ItemsControl x:Name="LineItems">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="60" />
                                        <ColumnDefinition Width="100" />
                                        <ColumnDefinition Width="100" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{Binding Name}" FontSize="13" />
                                        <TextBlock Text="{Binding Restaurant}"
                                                   Style="{StaticResource SubText}" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{Binding Qty}"
                                               TextAlignment="Center"
                                               VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="2" Text="{Binding UnitPriceText}"
                                               TextAlignment="Right"
                                               VerticalAlignment="Center"
                                               Style="{StaticResource SubText}" />
                                    <TextBlock Grid.Column="3" Text="{Binding LineTotalText}"
                                               TextAlignment="Right" FontWeight="SemiBold"
                                               VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Border Background="{StaticResource BorderBrush}"
                            Height="1" Margin="0,12,0,12" />

                    <!-- Totals -->
                    <Grid Margin="0,0,0,6">
                        <TextBlock Text="Subtotal" />
                        <TextBlock x:Name="SubtotalText" HorizontalAlignment="Right" />
                    </Grid>
                    <Grid x:Name="DiscountRow" Margin="0,0,0,6" Visibility="Collapsed">
                        <TextBlock x:Name="DiscountLabel"
                                   Foreground="{StaticResource GreenBrush}" />
                        <TextBlock x:Name="DiscountText"
                                   HorizontalAlignment="Right"
                                   Foreground="{StaticResource GreenBrush}" />
                    </Grid>
                    <Grid x:Name="DeliveryRow" Margin="0,0,0,6" Visibility="Collapsed">
                        <TextBlock Text="Delivery Fee" />
                        <TextBlock x:Name="DeliveryFeeText" HorizontalAlignment="Right" />
                    </Grid>

                    <Border Background="{StaticResource BorderBrush}"
                            Height="1" Margin="0,6,0,12" />

                    <Grid>
                        <TextBlock Text="GRAND TOTAL" FontSize="16" FontWeight="Bold" />
                        <TextBlock x:Name="GrandTotalText"
                                   HorizontalAlignment="Right"
                                   FontSize="22" FontWeight="Bold"
                                   Foreground="{StaticResource AccentBrush}" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Actions -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"
                        Margin="0,20,0,20">
                <Button Content="🔍  Browse More"
                        Style="{StaticResource PrimaryButton}"
                        Margin="0,0,12,0"
                        Click="BtnBrowse_Click" />
                <Button Content="📋  View Orders"
                        Style="{StaticResource TabInactiveButton}"
                        Click="BtnOrders_Click" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
