<Window x:Class="NICE.EAT.WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NICE.EAT — Smart Restaurant Recommender"
        Height="700" Width="980"
        MinHeight="620" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgDeepBrush}">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ═══ LEFT SIDEBAR ═══ -->
        <Border Grid.Column="0"
                Background="{StaticResource BgPanelBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Logo -->
                <StackPanel Grid.Row="0" Margin="20,28,20,24">
                    <TextBlock Text="🍽️ NICE.EAT"
                               FontSize="20" FontWeight="Bold"
                               Foreground="{StaticResource AccentBrush}" />
                    <TextBlock x:Name="UserBadge"
                               Style="{StaticResource SubText}"
                               Text="Not logged in"
                               Margin="0,4,0,0" />
                </StackPanel>

                <!-- Nav items -->
                <StackPanel Grid.Row="1" Margin="10,0">
                    <Button x:Name="NavLogin"
                            Style="{StaticResource NavButton}"
                            Content="🔑  Login / Register"
                            Margin="0,0,0,4"
                            Click="NavLogin_Click" />
                    <Button x:Name="NavRecommend"
                            Style="{StaticResource NavButton}"
                            Content="🔍  Recommendations"
                            IsEnabled="False"
                            Margin="0,0,0,4"
                            Click="NavRecommend_Click" />
                    <Button x:Name="NavOrders"
                            Style="{StaticResource NavButton}"
                            Content="📋  My Orders"
                            IsEnabled="False"
                            Margin="0,0,0,4"
                            Click="NavOrders_Click" />
                    <Button x:Name="NavCart"
                            Style="{StaticResource NavButton}"
                            IsEnabled="False"
                            Margin="0,0,0,4"
                            Click="NavCart_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🛒  Cart" />
                            <Border x:Name="CartBadge"
                                    Background="{StaticResource AccentBrush}"
                                    CornerRadius="8"
                                    Padding="6,1"
                                    Margin="8,0,0,0"
                                    Visibility="Collapsed">
                                <TextBlock x:Name="CartBadgeText"
                                           Text="0" FontSize="11"
                                           FontWeight="Bold"
                                           Foreground="White" />
                            </Border>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Bottom: logout -->
                <Button Grid.Row="2"
                        x:Name="BtnLogout"
                        Style="{StaticResource GhostButton}"
                        Content="⬅  Logout"
                        Margin="10,10,10,20"
                        Visibility="Collapsed"
                        Click="BtnLogout_Click" />
            </Grid>
        </Border>

        <!-- ═══ CONTENT FRAME ═══ -->
        <Frame x:Name="MainFrame"
               Grid.Column="1"
               NavigationUIVisibility="Hidden"
               Background="{StaticResource BgDeepBrush}" />
    </Grid>
</Window>
